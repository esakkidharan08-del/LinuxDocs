# Flask & JWT Secrets (REQUIRED - generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=
JWT_SECRET_KEY=

# Database URL (SQLite for local dev, Postgres for production)
# SQLite example: sqlite:///instance/app.db
# Postgres example: postgresql://user:pass@localhost:5432/linuxdocs
DATABASE_URL=sqlite:///instance/app.db

# Frontend origin for CORS (must match exactly, no trailing slash)
# Local dev: http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# Set to "production" to enable HSTS + strict CSP headers (Secure cookies).
# Leave unset for local development.
# FLASK_ENV=production

# Access-token lifetime (seconds). Refresh is handled by opaque, rotating,
# revocable sessions stored in the database (see below), NOT by JWT refresh
# tokens. JWT_REFRESH_TOKEN_EXPIRES is kept only for backwards compatibility.
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=2592000

# --- Persistent sessions ("remember me") ----------------------------------
# Long-lived, sliding sessions so users stay signed in indefinitely while the
# session keeps being refreshed; revocable from the database at any time.
SESSION_REMEMBER_TTL_DAYS=365   # sliding window for "remember me"
SESSION_TTL_HOURS=24            # short server-side TTL for non-remember sessions
# SameSite policy for the refresh cookie: Strict | Lax | None (default Strict).
# Keep Strict when the SPA and API are same-site. Use Lax/None only if they are
# served from different sites (None forces Secure cookies + requires HTTPS).
# SESSION_COOKIE_SAMESITE=Strict

# --- Rate limiting & brute-force protection ---------------------------------
# Enabled automatically in production; disabled under TESTING unless forced.
# Set RATE_LIMIT_ENABLED=1/0 to override.
# RATE_LIMIT_ENABLED=1
LOGIN_RATE_LIMIT=10             # login attempts per IP per minute
LOGIN_ACCOUNT_ATTEMPTS=5        # failed logins before an account lockout
LOGIN_ATTEMPT_WINDOW=900        # rolling window (seconds) for those attempts
LOGIN_LOCKOUT_SECONDS=900       # how long a locked account stays locked
REGISTER_RATE_LIMIT=10          # registrations per IP per minute
REFRESH_RATE_LIMIT=60           # token refreshes per IP per minute
RESET_REQUEST_RATE_LIMIT=5      # password-reset requests per IP per hour
RESET_RATE_LIMIT=10             # password resets per IP per hour
CHANGE_PASSWORD_RATE_LIMIT=10   # password changes per IP per 10 minutes
DELETE_ACCOUNT_RATE_LIMIT=5     # account deletions per IP per hour

# --- Request hygiene --------------------------------------------------------
MAX_CONTENT_LENGTH=1048576      # max JSON body size (bytes) -> 1 MiB
# Trust X-Forwarded-For / X-Forwarded-Proto from a reverse proxy. Only enable
# when the app sits behind a proxy you control (affects client-IP rate limits).
# TRUST_PROXY_HEADERS=1
# Extra allowed CSRF/CORS origins (comma-separated) beyond FRONTEND_ORIGIN.
# ALLOWED_ORIGINS=
# Extra connect-src hosts to whitelist in the Content-Security-Policy, e.g. if
# the API is served from a different origin than the SPA.
# CSP_EXTRA_CONNECT_SRC=

# --- Durable database (users are remembered forever) ------------------------
# Every connection gets WAL journaling + synchronous=FULL (committed rows
# survive a crash or power cut), foreign_keys=ON (SQLite defaults to OFF, so
# cascades silently did nothing) and a busy_timeout (writers wait instead of
# dropping the write). These are safe for SQLite only.
SQLITE_SYNCHRONOUS=FULL         # OFF | NORMAL | FULL | EXTRA (FULL = survive power loss)
SQLITE_BUSY_TIMEOUT_MS=10000    # how long a writer waits for the lock
SQLITE_JOURNAL_SIZE_LIMIT=67108864  # cap WAL growth at 64 MiB

# Verified backups (SQLite online-backup API, checked with integrity_check).
BACKUP_ON_STARTUP=1             # snapshot the DB on every boot
BACKUP_INTERVAL_SECONDS=86400   # scheduled backup cadence
BACKUP_KEEP=30                  # rotate, keeping the newest N snapshots
# BACKUP_DIR=                   # defaults to <db-dir>/backups
DB_AUTO_RESTORE=1               # at boot, restore newest good backup if corrupt
DB_INTEGRITY_CHECK=integrity    # integrity | quick (quick_check is faster)
# ROTATED_SESSION_RETENTION_HOURS=168   # keep rotated sessions for theft detection
# MAX_SESSIONS_PER_USER=25      # 0 disables; evicts oldest devices beyond this
# MAINTENANCE_ENABLED=1         # background backups + pruning of stale rows

# --- Global flood protection & Host allowlist ------------------------------
GLOBAL_RATE_LIMIT=600           # all requests per IP per minute (0 disables)
GLOBAL_RATE_WINDOW_SECONDS=60
# Reject requests whose Host header is not one we serve (Host-header poisoning
# / cache poisoning). localhost + 127.0.0.1 + ::1 and FRONTEND_ORIGIN are
# always allowed. Set ALLOWED_HOSTS=* to disable, or list extra names when the
# API is served from a different hostname than the SPA.
# ALLOWED_HOSTS=
# HOST_HEADER_CHECK=1

# --- Security audit log -----------------------------------------------------
# SEC-EVENT lines (rate limits, lockouts, origin/host rejections, session
# revocations) are mirrored to a rotating file next to the database.
# SECURITY_LOG_FILE=            # defaults to backend/instance/security.log
# SECURITY_LOG_MAX_BYTES=5242880
# SECURITY_LOG_BACKUPS=5

# --- Password-reset email delivery ------------------------------------------
# Reset tokens are NEVER returned by the API or logged; they are only ever
# emailed (or, in development, written to a local mailbox file). Choose a
# driver with MAIL_DRIVER, or let it auto-detect:
#   RESEND_API_KEY / SMTP_* present  -> resend / smtp
#   nothing set + FLASK_ENV!=prod    -> outbox  (writes .eml files to
#                                       instance/dev_outbox — read them there)
#   nothing set + FLASK_ENV=prod     -> none    (generic responses, no email)
#
# Option A — Resend HTTP API (recommended on Render; no SMTP ports involved):
# RESEND_API_KEY=re_xxxxxxxxxxxx
# MAIL_FROM=onboarding@resend.dev            # or "LinuxDocs <no-reply@yourdomain.com>"
#
# Option B — any SMTP server (Gmail: enable 2FA, create an App Password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# MAIL_FROM="LinuxDocs <you@gmail.com>"
#
# Optional explicit override (resend | smtp | outbox | none):
# MAIL_DRIVER=smtp
# RESET_TOKEN_TTL_MINUTES=30                 # single-use link lifetime
